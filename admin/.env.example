# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon key is
# public by design and safe to ship in this admin build; RLS policies do
# the actual access control.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Base URL for the deployed edge functions, used for the "Auto-translate
# missing strings" button. Usually {VITE_SUPABASE_URL}/functions/v1
VITE_FUNCTIONS_URL=https://YOUR-PROJECT.supabase.co/functions/v1
